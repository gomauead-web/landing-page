rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['fullname', 'email', 'whatsapp', 'city_state', 'profession', 'age', 'motivation', 'createdAt'])
        && data.keys().size() == 8
        && data.fullname is string && data.fullname.size() > 0 && data.fullname.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() <= 30
        && data.city_state is string && data.city_state.size() > 0 && data.city_state.size() <= 150
        && data.profession is string && data.profession.size() > 0 && data.profession.size() <= 150
        && (data.age is string || data.age is number)
        && data.motivation is string && data.motivation.size() > 0 && data.motivation.size() <= 3000
        && data.createdAt == request.time;
    }

    match /leads/{leadId} {
      allow read, update, delete: if false;
      allow create: if isValidId(leadId) && isValidLead(incoming());
    }
  }
}

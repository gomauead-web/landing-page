{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A prospective member contact submission.",
      "type": "object",
      "properties": {
        "fullname": { "type": "string", "description": "Full name of the lead" },
        "email": { "type": "string", "description": "Email address of the lead" },
        "whatsapp": { "type": "string", "description": "WhatsApp contact number" },
        "city_state": { "type": "string", "description": "City and State of the lead" },
        "profession": { "type": "string", "description": "Lead's profession" },
        "age": { "type": "string", "description": "Lead's age" },
        "motivation": { "type": "string", "description": "Motivation for joining" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["fullname", "email", "whatsapp", "city_state", "profession", "age", "motivation", "createdAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Collection of incoming leads."
    }
  }
}
